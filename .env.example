# ─────────────────────────────────────────────────────────────────────────────
# ElectricAI — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── External API Keys ─────────────────────────────────────────────────────────
# Obtain from: https://registrationapps.bls.gov/bls_registration/home
BLS_API_KEY=

# Obtain from: https://api.openei.org
Openei_API_KEY=

# Obtain from: https://www.eia.gov/opendata/
EIA_API_KEY=

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_DAYS=30

# Set to true in production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:5173

# ── Email ─────────────────────────────────────────────────────────────────────
# Set EMAIL_CONSOLE_ONLY=false and fill SMTP credentials for real email delivery
EMAIL_CONSOLE_ONLY=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@electricai.app
