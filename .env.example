# ─────────────────────────────────────────────────────────────────────────────
# ElectricAI — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── External API Keys ─────────────────────────────────────────────────────────
# Obtain from: https://registrationapps.bls.gov/bls_registration/home
BLS_API_KEY=

# Obtain from: https://api.openei.org
Openei_API_KEY=

# Obtain from: https://www.eia.gov/opendata/
EIA_API_KEY=

# ── Environment ───────────────────────────────────────────────────────────────
# development (default) | staging | production
# Anything other than development enforces strong JWT secrets and requires an
# explicit CORS_ALLOW_ORIGINS; the app refuses to start otherwise.
APP_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of exact browser origins allowed to call the API.
# Required when APP_ENV is staging/production. '*' is rejected because the API
# sends credentials. Leave blank in development to use the localhost defaults.
# Example: CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOW_ORIGINS=

# ── Google OAuth (Continue with Google) ───────────────────────────────────────
# Create at: Google Cloud Console -> APIs & Services -> Credentials ->
#   Create credentials -> OAuth client ID -> Application type: Web application
#
# Under "Authorised redirect URIs" add EXACTLY the value of GOOGLE_REDIRECT_URI
# below, including scheme, host and port. Google matches it character for
# character; a trailing slash or http vs https mismatch is rejected.
#
# Leave these blank to disable Google sign-in: the button then returns a clear
# "not configured" message instead of failing silently.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_DAYS=30

# Set to true in production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:5173

# ── Email ─────────────────────────────────────────────────────────────────────
# Set EMAIL_CONSOLE_ONLY=false and fill SMTP credentials for real email delivery
EMAIL_CONSOLE_ONLY=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@electricai.app
